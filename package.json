{
  "name": "solpitch-listings",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "api:dev": "wrangler dev",
    "api:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply solpitch-listings --local",
    "db:migrate:remote": "wrangler d1 migrations apply solpitch-listings --remote",
    "api:deploy": "wrangler deploy"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "wrangler": "latest"
  }
}
